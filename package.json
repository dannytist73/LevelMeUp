{
  "name": "levelmeup",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "supabase",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm -ws test",
    "typecheck": "npm -ws run typecheck",
    "check:portable": "node packages/rules/scripts/portable-check.ts && node packages/content/scripts/portable-check.ts",
    "pacing": "node packages/rules/scripts/pacing-report.ts && node packages/content/scripts/campaign-report.ts",
    "content:review": "node packages/content/scripts/review.ts",
    "sb": "node scripts/sb.ts",
    "db:deploy": "node scripts/db-deploy.ts",
    "db:test": "node scripts/db-test.ts",
    "check:functions": "deno check --config supabase/deno.check.json supabase/functions/lmu-onboarding/index.ts supabase/functions/lmu-sync/index.ts supabase/functions/lmu-account-delete/index.ts supabase/functions/lmu-articles-tick/index.ts",
    "deploy:functions": "node scripts/sb.ts functions deploy lmu-onboarding lmu-sync lmu-account-delete lmu-articles-tick --project-ref knlgpcwoaaygncmlnbsm --use-api",
    "lmu:password": "node scripts/lmu-service-password.ts",
    "articles": "node scripts/articles.ts",
    "pilot": "node scripts/pilot.ts",
    "test:live": "npm -w supabase run test:live",
    "app": "npm -w @levelmeup/mobile run start",
    "check:bundle": "npm -w @levelmeup/mobile run check:bundle"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "2.118.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
