{
  "expo": {
    "name": "LevelMeUp",
    "slug": "levelmeup",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "levelmeup",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E10"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F0765E"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/BlackHanSans-Latin.ttf",
            "./assets/fonts/GothicA1-Regular-Latin.ttf",
            "./assets/fonts/GothicA1-Bold-Latin.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "LevelMeUp",
              "description": "Today's quest and your streak",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "android": {
      "package": "com.dannytist.levelmeup",
      "versionCode": 5,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3dec5d4-7d00-4aa6-b3e9-9555f85cbf74"
      }
    },
    "owner": "dannytist.73"
  }
}
