{
  "expo": {
    "name": "LevelMeUp",
    "slug": "levelmeup",
    "version": "0.15.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "levelmeup",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111315",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#111315"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3463E8"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/MPlusRounded1c-ExtraBold-Latin.ttf",
            "./assets/fonts/MPlusRounded1c-Regular-Latin.ttf",
            "./assets/fonts/MPlusRounded1c-Bold-Latin.ttf",
            "./assets/fonts/Geist-SemiBold-Latin.ttf",
            "./assets/fonts/Geist-Regular-Latin.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "LevelMeUp",
              "description": "Your next workout, chapter and food today",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "android": {
      "package": "com.dannytist.levelmeup",
      "versionCode": 19,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3dec5d4-7d00-4aa6-b3e9-9555f85cbf74"
      }
    },
    "owner": "dannytist.73"
  }
}
